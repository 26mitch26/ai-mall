{
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(docker-compose *)",
      "Bash(docker *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(chmod *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ]
      }
    ]
  }
}
